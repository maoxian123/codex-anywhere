# Copy via `codex-anywhere init`, which generates SECRET_KEY and ADMIN_PASSWORD.
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password

# SQLite for a local single-process hub. Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///codex-anywhere.db
ASSET_DIR=instance/assets
COOKIE_SECURE=false
# External browser origin when using HTTPS reverse proxy or Vite dev server.
# PUBLIC_URL=https://codex.example.com
PUBLIC_URL=

# Only needed for `docker compose up --build`.
POSTGRES_PASSWORD=replace-with-a-different-database-password
