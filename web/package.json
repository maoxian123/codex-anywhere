{
  "name": "codex-anywhere-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test src/utils.test.ts src/api.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src public index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src public index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
